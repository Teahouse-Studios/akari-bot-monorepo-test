# 适配器包清单。
# schema 与 requires_core_api 供发现层校验本包与当前 core 的公共 API 契约；
# config_table 为适配器 config.py 中 on_bot_config() 声明的配置表，
# credential_fields 供守护进程在启动前检测「同一平台的两个实例配了同一账号」。
# 平台入口在 pyproject.toml 的 akaribot.adapters entry point，展示名在 info.py 的 platform_name。
schema = 1
requires_core_api = ">=1"
locales = "locales"
{% if has_config | default(false) %}config_table = "bot_[@module_name@]"
credential_fields = {{ credential_fields_toml | default("[]") }}{% else %}# 未生成 config.py：不声明 config_table，守护进程不会拉起本平台。{% endif %}
