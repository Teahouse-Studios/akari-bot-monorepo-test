[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "akari-bot-module-[@module_name@]"
version = "0.1.0"
description = "[@module_desc@]"
readme = "README.md"
requires-python = ">=3.12,<4.0"
license = "[@license@]"
authors = [{ name = "[@author@]" }]
dependencies = [
    "akari-bot-core>=1.0,<2.0",
]

[project.entry-points."akaribot.modules"]
"[@module_name@]" = "akaribot.modules.[@module_name@]"

[tool.hatch.build.targets.wheel]
packages = ["src/akaribot"]

# locales / assets / migrations 是包内数据，默认会被 wheel 收录；
# force-include 在此显式声明，避免后续调整 packages 时漏包。
[tool.hatch.build.targets.wheel.force-include]
"src/akaribot/modules/[@module_name@]/locales" = "akaribot/modules/[@module_name@]/locales"
"src/akaribot/modules/[@module_name@]/assets" = "akaribot/modules/[@module_name@]/assets"
"src/akaribot/modules/[@module_name@]/migrations" = "akaribot/modules/[@module_name@]/migrations"
