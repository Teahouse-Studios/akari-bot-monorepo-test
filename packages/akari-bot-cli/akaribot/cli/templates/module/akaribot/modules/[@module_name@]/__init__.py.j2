"""[@module_desc@]"""
{% if has_data_dir | default(false) or has_assets | default(false) %}
{% if has_data_dir | default(false) %}import os
{% endif %}{% if has_assets | default(false) %}from importlib.resources import files
{% endif %}{% if has_data_dir | default(false) %}from pathlib import Path
{% endif %}{% endif %}
from akaribot.core.api import (
{% for api_name in api_names | default(["module"]) %}    {{ api_name }},
{% endfor %})

mod = module(
    "[@module_name@]",
{% if aliases | default([]) %}    alias={{ aliases | default([]) | tojson }},
{% endif %}    desc="{I18N:[@module_name@].help.desc}",
    doc=True,
{% if available_for | default([]) %}    available_for={{ available_for | default([]) | tojson }},
{% endif %}{% if exclude_from | default([]) %}    exclude_from={{ exclude_from | default([]) | tojson }},
{% endif %}{% if has_regex | default(false) %}    regex=True,
{% endif %}{% if has_event | default(false) %}    event=True,
{% endif %})
{% for command in commands | default([]) %}

@mod.command({{ command.declaration }})
async def _({{ command.signature }}):
    await msg.finish(I18NContext({{ command.message_literal }}))
{% endfor -%}
{% if has_regex | default(false) %}

@mod.regex(r"\{\{(.*?)}}", mode="M")
async def _(msg: Bot.MessageSession):
    # wait_reply 返回新会话，其输入取自被回复的消息。
    session = await msg.wait_reply(I18NContext("[@module_name@].message.reply"))
    await session.finish(msg.matched_msg.group(1))
{% endif -%}
{% if has_schedule | default(false) %}

@mod.schedule(IntervalTrigger(seconds=3600))
async def _():
    # 定时任务无会话上下文，投递目标须为已启用该模块的场景名。
    await Bot.post_message("[@module_name@]", I18NContext("[@module_name@].message.scheduled"))
{% endif -%}
{% if has_hook | default(false) %}

@mod.hook(point=HookPoint.MESSAGE_NORMALIZED)
async def _(ctx: Bot.ModuleHookContext):
    # 返回 None 表示不干预；需要截断或改写消息时返回 HookResult 类型化结果。
    return None
{% endif -%}
{% if has_event | default(false) %}

@mod.event("member_joined")
async def _(event: EventInfo):
    # 事件名由平台适配器定义，不同平台可用的名称不同。
    return None
{% endif -%}
{% if has_assets | default(false) %}

def read_asset(name: str) -> str:
    """读取包内只读资源。

    :param name: ``assets/`` 下的相对路径。
    :return: 文件内容。
    """
    return (files(__package__) / "assets" / name).read_text(encoding="utf-8")
{% endif -%}
{% if has_data_dir | default(false) %}

def data_dir() -> Path:
    """本模块在实例内的可写数据目录。

    目录不在这里创建，写入方以 ``mkdir(parents=True, exist_ok=True)`` 建目录。路径取自实例
    布局：``AKARI_INSTANCE_DIR`` 未设置时与 core 一致地取进程工作目录。
    """
    root = Path(os.environ.get("AKARI_INSTANCE_DIR") or ".").resolve()
    return root / "data" / "module" / "[@module_name@]"
{% endif -%}
